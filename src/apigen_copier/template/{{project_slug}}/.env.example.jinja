# Database Configuration
{% if project.data_driver == 'postgresql' %}
DB_USER=user
DB_PASSWORD=password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dbname
{% elif project.data_driver == 'mysql' %}
DB_USER=user
DB_PASSWORD=password
DB_HOST=localhost
DB_PORT=3306
DB_NAME=dbname
{% elif project.data_driver == 'mssql' %}
DB_USER=sa
DB_PASSWORD=password
DB_HOST=host.docker.internal
DB_PORT=1433
DB_NAME=dbname
{% else %}
# For SQLite, we use a direct URL
DATABASE_URL=sqlite+aiosqlite:///./test.db
{% endif %}

